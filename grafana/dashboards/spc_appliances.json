      "title": "Fridge",
      "type": "row"
    },
    {
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "description": "Fridge compressor running watts (>50W threshold)\n\nSourced entirely from Home Assistant's own SPC entities - the same numbers the HA control charts show. The InfluxDB `spc` continuous queries were retired 2026-08-22: they were a second definition of the same metric and had drifted (dehumidifier -9.0 W, and all five bucketed on UTC days rather than America/New_York).\n\nLimits and the centre line use LAST(), not MEAN(): mean_7d, upper and lower are STEP functions that change once a night when the buffer rotates. Averaging them across a day blends the old and new limit and can put a healthy point outside a control band that never existed - it did exactly that to HWH Recirc (daily 109.5 against a blended UCL of 108.77, when the limit in force was 109.6).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisLabel": "Watts",
            "axisPlacement": "auto",
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 8,
            "showPoints": "auto",
            "spanNulls": false
          },
          "unit": "watt"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Daily"
            },
            "properties": [
              {
                "id": "custom.drawStyle",
                "value": "points"
              },
              {
                "id": "custom.pointSize",
                "value": 10
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Mean"
            },
            "properties": [
              {
                "id": "custom.showPoints",
                "value": "never"
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "UCL"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    10
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.showPoints",
                "value": "never"
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "LCL"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [
                    10,
                    10
                  ],
                  "fill": "dash"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "custom.showPoints",
                "value": "never"
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "mean"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "alias": "Daily",
          "query": "SELECT \"value\" AS \"Daily\" FROM \"W\" WHERE \"entity_id\" = 'fridge_running_watts_day_1' AND $timeFilter",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "time_series"
        },
        {
          "alias": "Mean",
          "query": "SELECT LAST(\"value\") AS \"Mean\" FROM \"W\" WHERE \"entity_id\" = 'fridge_running_watts_mean_7d' AND $timeFilter GROUP BY time(1d) fill(null)",
          "rawQuery": true,
          "refId": "B",
          "resultFormat": "time_series"
        },
        {
          "alias": "UCL",
          "query": "SELECT LAST(\"value\") AS \"UCL\" FROM \"W\" WHERE \"entity_id\" = 'fridge_running_watts_upper' AND $timeFilter GROUP BY time(1d) fill(null)",
          "rawQuery": true,
          "refId": "C",
          "resultFormat": "time_series"
        },
        {
          "alias": "LCL",
          "query": "SELECT LAST(\"value\") AS \"LCL\" FROM \"W\" WHERE \"entity_id\" = 'fridge_running_watts_lower' AND $timeFilter GROUP BY time(1d) fill(null)",
          "rawQuery": true,
          "refId": "D",
          "resultFormat": "time_series"
        }
      ],
      "title": "Fridge — Running Watts SPC",
      "type": "timeseries"
    },

{
  "annotations": {
    "list": []
  },
  "description": "Raw signals for reading furnace cycles by eye. Computes nothing: cycle labels, clean-cycle selection and the gas-per-minute fit live in scripts/furnace_gas_cycles.py, which reads these same five series.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {
        "type": "influxdb",
        "uid": "${DS_INFLUXDB}"
      },
      "description": "**Red:** furnace CT watts (`sensor.sem_furnace_power`). It times the cycles; it also rises for fan-only and cooling runs.\n\n**Green, right axis:** gas meter reading, ft³. Each step is 2 ft³ and lands when the SDR next decodes, not when the gas was burned.\n\n**Purple:** Navien plug watts. When it rises the water heater is firing, and gas steps in that span are not all furnace.\n\n**Shaded:** orange is the HomeKit heat call (`binary_sensor.hvac_furnace_running`), which is glitchy, so do not time cycles from it. Blue is the AC compressor.\n\nThe gas meter and both calls are written only when they change, so their queries reach back before the window (3 d and 30 d) to carry in the last value.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisLabel": "W",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "lineInterpolation": "stepAfter",
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "watt"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Furnace CT"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Navien plug"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "purple",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Gas meter"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.axisLabel",
                "value": "ft³ (meter reading)"
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "HomeKit heat call"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bool_on_off"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "custom.axisPlacement",
                "value": "hidden"
              },
              {
                "id": "custom.fillOpacity",
                "value": 15
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "AC compressor"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bool_on_off"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "custom.axisPlacement",
                "value": "hidden"
              },
              {
                "id": "custom.fillOpacity",
                "value": 15
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "fixedColor": "blue",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "interval": "5s",
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "alias": "Furnace CT",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "SELECT max(\"value\") FROM \"W\" WHERE \"entity_id\" = 'sem_furnace_power' AND \"domain\" = 'sensor' AND $timeFilter GROUP BY time($__interval) fill(previous)",
          "rawQuery": true,
          "refId": "A",
          "resultFormat": "time_series"
        },
        {
          "alias": "Gas meter",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "SELECT \"value\" FROM \"ft³\" WHERE \"entity_id\" = 'gas_meter_volume' AND \"domain\" = 'sensor' AND time >= ${__from}ms - 3d AND time <= ${__to}ms",
          "rawQuery": true,
          "refId": "B",
          "resultFormat": "time_series"
        },
        {
          "alias": "Navien plug",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "SELECT max(\"value\") FROM \"W\" WHERE \"entity_id\" = 'hwh_current_consumption' AND \"domain\" = 'sensor' AND $timeFilter GROUP BY time($__interval) fill(previous)",
          "rawQuery": true,
          "refId": "C",
          "resultFormat": "time_series"
        },
        {
          "alias": "HomeKit heat call",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "SELECT \"value\" FROM \"binary_sensor.hvac_furnace_running\" WHERE \"entity_id\" = 'hvac_furnace_running' AND time >= ${__from}ms - 30d AND time <= ${__to}ms",
          "rawQuery": true,
          "refId": "D",
          "resultFormat": "time_series"
        },
        {
          "alias": "AC compressor",
          "datasource": {
            "type": "influxdb",
            "uid": "${DS_INFLUXDB}"
          },
          "query": "SELECT \"value\" FROM \"binary_sensor.ac_compressor_running\" WHERE \"entity_id\" = 'ac_compressor_running' AND time >= ${__from}ms - 30d AND time <= ${__to}ms",
          "rawQuery": true,
          "refId": "E",
          "resultFormat": "time_series"
        }
      ],
      "title": "Furnace cycle overlay: CT, gas meter, Navien, calls",
      "type": "timeseries"
    }
  ],
  "refresh": "5m",
  "schemaVersion": 39,
  "tags": [
    "hvac",
    "furnace",
    "gas"
  ],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-12h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Furnace Cycles",
  "uid": "furnace-cycles"
}

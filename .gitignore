# Secrets and sensitive data
secrets.yaml
secrets_*.yaml
*.pem
*.key

# Home Assistant internal storage (contains auth tokens, user data)
.storage/

# Database files
*.db
*.db-shm
*.db-wal

# Cloud connection
.cloud/

# Dependencies (auto-downloaded)
deps/

# Text-to-speech cache
tts/

# Log files
*.log
*.log.*
home-assistant.log.fault

# Backups (if any)
*.bak
backups/

# Python cache
__pycache__/
*.py[cod]

# OS files
.DS_Store
Thumbs.db
*.lnk

# IDE files
.vscode/
.idea/

# Lock files
.ha_run.lock

# Null file (artifact)
nul

# Custom components downloaded via HACS (optional - uncomment if you want to exclude)
# custom_components/hacs/

# Aider tooling history and tag cache (local, not config)
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v4/

# Temp files left by scripts/test_ha_audit.py verification runs
scripts/.verify_*.tmp

# Local caches
.cache/

# ESPHome Device Builder local artifacts - the peer link key is a credential
esphome/.device-builder*

# LibreOffice / OpenOffice lock files (appear while a CSV is open in a viewer)
.~lock.*#

# Reference copy of the separate HVAC Baseline repo - 2.0 MB of another
# project's content. Belongs in its own repo, not vendored into this one,
# where it would silently go stale against its source.
baseline-repo/

# ha_source.py cache of HA core source, pinned per .HA_VERSION.
# Derived, refetchable, and large - never commit it.
docs/vendor/

# Runtime state from the audit toolchain, added 2026-08-26. Both are
# per-machine and derived: .audit_baseline.json is the finding set gate.py
# diffs against, .ha_audit_stamp is the Stop hook's mtime + block counter.
# Committing either would make every machine fight over the other's state.
.audit_baseline.json
.claude/hooks/.ha_audit_stamp
